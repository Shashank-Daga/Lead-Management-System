# PostgreSQL connection string — fill this in once you provision a database.
# Local dev (see docker-compose.yml in repo root):
# DATABASE_URL="postgresql://lms_user:lms_password@localhost:5432/lms_db?schema=public"
DATABASE_URL=""

# JWT secrets — generate strong random values before deploying, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"
